/* ===== state ===== */
const KEY="eigoGym_v2";
function load(){try{return JSON.parse(localStorage.getItem(KEY))||{}}catch(e){return{}}}
function save(){localStorage.setItem(KEY,JSON.stringify(S))}
let S=load();
S.lessons=S.lessons||{};          // {id:{lap,quizOk,quizTot,answered:[]}}
S.words=S.words||[];              // 全教材横断の単語バンク
S.totalLap=S.totalLap||0;
S.studyDates=S.studyDates||{};    // {date:true} 学習した日
LESSONS.forEach(L=>{ S.lessons[L.id]=S.lessons[L.id]||{lap:0,quizOk:0,quizTot:0,answered:[]}; });
save();

let idx=0;                        // 現在表示中の教材index
let L=LESSONS[idx];
let rec=S.lessons[L.id];

/* ===== speech ===== */
let voice=null;
function pickVoice(){const vs=speechSynthesis.getVoices();
  voice=vs.find(v=>/en-US/i.test(v.lang)&&/female|Samantha|Google US/i.test(v.name))
    ||vs.find(v=>/en-US/i.test(v.lang))||vs.find(v=>/en/i.test(v.lang))||null;}
if('speechSynthesis' in window){pickVoice();speechSynthesis.onvoiceschanged=pickVoice;}
function speak(t,rate=0.9){if(!('speechSynthesis' in window))return;
  speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t.replace(/\|/g,''));
  u.lang='en-US';u.rate=rate;if(voice)u.voice=voice;speechSynthesis.speak(u);return u;}

/* ===== reading render ===== */
let playing=false;
function renderRead(){
  document.getElementById('mTitle').textContent=L.title;
  document.getElementById('mSrc').textContent=L.src;
  const list=document.getElementById('sentList');list.innerHTML='';
  L.sentences.forEach((s,i)=>{
    const d=document.createElement('div');d.className='sent';d.dataset.i=i;
    d.innerHTML=`<div class="num">${String(i+1).padStart(2,'0')}</div>
      <div class="en">${s.en}</div>${s.hint?`<div class="hint">${s.hint}</div>`:''}
      <button class="play">▶</button>`;
    d.querySelector('.play').onclick=e=>{e.stopPropagation();activate(i);speak(s.en);};
    d.onclick=()=>{activate(i);speak(s.en);};
    list.appendChild(d);
  });
  document.getElementById('tipBox').innerHTML=`<div class="h">${L.tip.h}</div><div class="c">${L.tip.c}</div>`;
  refreshLap();
}
function activate(i){document.querySelectorAll('.sent').forEach(el=>el.classList.toggle('active',+el.dataset.i===i));}

document.getElementById('playAll').onclick=function(){
  if(playing){speechSynthesis.cancel();playing=false;this.textContent='▶ 全文お手本';return;}
  playing=true;this.textContent='⏸ 停止';let i=0;const btn=this;
  const next=()=>{if(!playing||i>=L.sentences.length){playing=false;btn.textContent='▶ 全文お手本';return;}
    activate(i);const u=speak(L.sentences[i].en);
    if(u){u.onend=()=>{i++;setTimeout(next,250);};}else{i++;next();}};
  next();
};

function markStudied(){S.studyDates[L.date>today?today:today]=true;} // 学習日は「今日」を記録
function refreshLap(){
  document.getElementById('lapNow').textContent=rec.lap;
  document.getElementById('cLap').textContent=rec.lap;
  const b=document.getElementById('lapBtn');
  if(rec.lap>=5){b.textContent='🎉 5周達成!';b.classList.remove('amber');b.classList.add('lime');}
  else{b.textContent='1周 完了 +';b.classList.add('amber');b.classList.remove('lime');}
}
document.getElementById('lapBtn').onclick=()=>{
  if(rec.lap>=5)return;
  rec.lap++;S.totalLap++;S.studyDates[today]=true;save();refreshLap();refreshDash();
};

/* ===== words render ===== */
function renderWords(){
  const wl=document.getElementById('wordList');wl.innerHTML='';
  L.words.forEach(w=>{
    const learned=S.words.includes(w.w);
    const d=document.createElement('div');d.className='word';
    d.innerHTML=`<div class="top"><div><div class="w">${w.w}</div><div class="ph">/${w.ph}/</div></div><div class="pos">${w.pos}</div></div>
      <div class="body"><div class="mean">${w.mean}</div><div class="ex">"${w.ex}"</div>
      <button class="sp">${learned?'✓ 単語帳に追加済み':'🔊 発音 + 単語帳に追加'}</button></div>`;
    d.querySelector('.top').onclick=()=>d.classList.toggle('open');
    d.querySelector('.sp').onclick=e=>{e.stopPropagation();speak(w.w,0.8);
      if(!S.words.includes(w.w)){S.words.push(w.w);save();refreshDash();}
      e.target.textContent='✓ 単語帳に追加済み';};
    wl.appendChild(d);
  });
}

/* ===== quiz ===== */
let qi=0;
function fmtAns(en){return en.replace(/\|(.+?)\|/g,'<span class="key">$1</span>');}
function showQ(){
  const Q=L.quiz;
  document.getElementById('qTot').textContent=Q.length;
  const q=Q[qi];
  document.getElementById('qJp').textContent=q.jp;
  document.getElementById('qAns').innerHTML=fmtAns(q.en);
  document.getElementById('qAns').classList.add('hidden');
  document.getElementById('qShow').style.display='block';
  document.getElementById('qScoreBtns').style.display='none';
  document.getElementById('qNow').textContent=qi+1;
}
document.getElementById('qShow').onclick=()=>{
  document.getElementById('qAns').classList.remove('hidden');speak(L.quiz[qi].en);
  document.getElementById('qShow').style.display='none';
  document.getElementById('qScoreBtns').style.display='flex';
};
function record(ok){
  if(!rec.answered.includes(qi)){
    rec.answered.push(qi);rec.quizTot++;if(ok)rec.quizOk++;
    S.studyDates[today]=true;save();refreshQuizStat();refreshDash();
  }
  const Q=L.quiz;
  if(qi<Q.length-1){qi++;showQ();}
  else{document.getElementById('qJp').textContent='🎉 全問おつかれさま!';
    document.getElementById('qAns').innerHTML='';document.getElementById('qAns').classList.remove('hidden');
    document.getElementById('qShow').style.display='none';document.getElementById('qScoreBtns').style.display='none';}
}
document.getElementById('qOk').onclick=()=>record(true);
document.getElementById('qNg').onclick=()=>record(false);
document.getElementById('qPrev').onclick=()=>{if(qi>0){qi--;showQ();}};
document.getElementById('qReset').onclick=()=>{qi=0;showQ();};
function refreshQuizStat(){
  const pct=rec.quizTot?Math.round(rec.quizOk/rec.quizTot*100):0;
  document.getElementById('cQuiz').textContent=pct+'%';
  document.getElementById('dQuiz').textContent=pct;
}

/* ===== lesson switch ===== */
function switchLesson(n){
  idx=(n+LESSONS.length)%LESSONS.length;
  L=LESSONS[idx];rec=S.lessons[L.id];qi=0;
  speechSynthesis.cancel();playing=false;document.getElementById('playAll').textContent='▶ 全文お手本';
  document.getElementById('lDay').textContent=`DAY ${L.day} · ${L.date}`;
  document.getElementById('lTitle').textContent=L.title;
  document.getElementById('prevL').disabled=LESSONS.length<=1;
  document.getElementById('nextL').disabled=LESSONS.length<=1;
  renderRead();renderWords();showQ();refreshQuizStat();refreshDash();
}
document.getElementById('prevL').onclick=()=>switchLesson(idx-1);
document.getElementById('nextL').onclick=()=>switchLesson(idx+1);

/* ===== tabs ===== */
document.querySelectorAll('.tab').forEach(t=>{
  t.onclick=()=>{
    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
    document.querySelectorAll('.panel').forEach(x=>x.classList.remove('on'));
    t.classList.add('on');document.getElementById(t.dataset.p).classList.add('on');
    speechSynthesis.cancel();playing=false;document.getElementById('playAll').textContent='▶ 全文お手本';
  };
});

/* ===== date / streak ===== */
const today=new Date().toISOString().slice(0,10);
function calcStreak(){
  let streak=0;const cur=new Date(today);
  for(;;){const ds=cur.toISOString().slice(0,10);
    if(S.studyDates[ds]){streak++;cur.setDate(cur.getDate()-1);}else break;}
  return streak;
}

/* ===== dashboard ===== */
function refreshDash(){
  const st=calcStreak();
  document.getElementById('cStreak').textContent=st;
  document.getElementById('dStreak').textContent=st;
  document.getElementById('cWords').textContent=S.words.length;
  document.getElementById('dTotalLap').textContent=S.totalLap;
  const wb=document.getElementById('wbank');
  wb.innerHTML=S.words.length?S.words.map(w=>`<span>${w}</span>`).join(''):'<span style="color:var(--sub);border:none;background:none">まだありません</span>';
  const heat=document.getElementById('heat');heat.innerHTML='';
  for(let k=13;k>=0;k--){const dt=new Date(today);dt.setDate(dt.getDate()-k);
    const ds=dt.toISOString().slice(0,10);const i=document.createElement('i');
    i.textContent=dt.getDate();if(S.studyDates[ds])i.className='done';heat.appendChild(i);}
  refreshQuizStat();
}
document.getElementById('resetAll').onclick=()=>{
  if(confirm('すべての学習記録を消去します。よろしいですか？')){localStorage.removeItem(KEY);location.reload();}
};

/* ===== init ===== */
switchLesson(0);

/* ===== PWA: Service Worker（オフライン対応） =====
   GitHub Pages配置時に同ディレクトリの sw.js を登録。
   file:// では動かないが、https のGitHub Pagesでオフライン化される。 */
if('serviceWorker' in navigator && location.protocol.startsWith('http')){
  window.addEventListener('load',()=>{
    navigator.serviceWorker.register('sw.js').catch(()=>{});
  });
}
</script>


